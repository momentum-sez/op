op mutual_recognition.register for adgm
version "0.1.0"
description "Register an ADGM entity as a Seychelles IBC branch under a bilateral corridor whose translation phi is partial."

inputs {
  entity_id: EntityId,
  target_zone: String,
  corridor: String
}

outputs {
  registration_id: String,
  status: String
}

participants {
  adgm_entity:       SourceZone(entity_id);
  seychelles_branch: DestinationZone(entity_id);
}
approval bilateral;

effects {
  sanctions_check;
  sovereign_write;
  proof_emit;
  external_read;
}

contracts {
  requires domains [corporate, aml, beneficial_ownership, sanctions];
  ensures  domains [corporate, aml, beneficial_ownership, sanctions];
}

do {
  in adgm_zone {
    run t_a = screening.sanctions({
      entity_id: entity_id,
      zone: "adgm"
    });
  }

  in seychelles_zone {
    run t_b = screening.sanctions({
      entity_id: entity_id,
      zone: "seychelles"
    });
  }

  run t_ab = attestation.emit({
    corridor: corridor,
    lhs: t_a,
    rhs: t_b,
    untranslated_policy: "NotApplicable"
  });

  choose {
    when t_ab.image_verdict == "Compliant" -> {
      run registration = filing.registry_amendment({
        entity_id: entity_id,
        target_zone: target_zone,
        composed_tensor: t_ab
      });
      return { registration_id: registration.filing_id, status: "REGISTERED" };
    }
    else -> {
      return { registration_id: "", status: "BLOCKED" };
    }
  }
}
